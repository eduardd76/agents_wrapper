{
  "name": "multi-agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "AI coding agent orchestrator for Claude, OpenAI, Gemini, and local-operator",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter '*' build",
    "dev": "pnpm --filter '*' dev",
    "test": "pnpm --filter '*' test",
    "lint": "pnpm --filter '*' lint",
    "clean": "pnpm --filter '*' clean && rm -rf node_modules",
    "cli": "pnpm --filter @multi-agent/cli start",
    "web": "pnpm --filter @multi-agent/web dev"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
