{
  "name": "@multi-agent/mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing the multi-agent orchestrator to Claude Code",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --minify --legal-comments=none --outfile=../../plugins/agents-wrapper/server/index.cjs",
    "start": "node ../../plugins/agents-wrapper/server/index.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@multi-agent/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
