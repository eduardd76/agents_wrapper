# API Keys - Required for agent execution
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Local Operator Configuration (optional)
LOCAL_OPERATOR_MODE=api  # or "cli"
LOCAL_OPERATOR_API_URL=http://localhost:8080
LOCAL_OPERATOR_MODEL=openai:gpt-4o-mini

# Session Storage
SESSION_STORAGE_PATH=~/.multi-agent/sessions

# Cost Controls
MAX_DAILY_SPEND=10.00  # USD
MAX_MONTHLY_SPEND=100.00  # USD
WARN_THRESHOLD=0.50  # USD per request

# Logging
LOG_LEVEL=info  # debug, info, warn, error
